<?xml version="1.0" encoding="utf-8"?>
<!--
  The -v26 qualifier stays even though minSdk is 26 and lint calls it obsolete: AAPT2 refuses to
  resolve an adaptive icon from a plain -anydpi folder ("resource mipmap/ic_launcher not found").
  Verified by breaking the build, not assumed.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
