<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device. Recordings of phone calls have no business in a cloud backup or in a
  device-to-device transfer, so both paths are emptied rather than left to the platform default.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
