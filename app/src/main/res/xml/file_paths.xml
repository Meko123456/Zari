<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Only the recordings folder is shareable; nothing else of the app's is exposed.
         files-path, not external-files-path: recordings live in internal storage so that other
         apps cannot read them directly on Android 8 and 9. Sharing one is still possible, but only
         through this provider and only for the single URI the user picked. -->
    <files-path name="recordings" path="recordings/" />
</paths>
